.detail-page {
  padding-bottom: 160rpx;
}

.pay-banner {
  background: linear-gradient(135deg, #fff5e9, #ffe8cc);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.pay-banner-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #a85a12;
}

.pay-banner-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #b57a3a;
}

.status-card {
  background: linear-gradient(135deg, #0f9d58, #0b7a43);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 700;
}

.status-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
}

.status-card .status-pill {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.status-amount {
  margin-top: 28rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.status-amount .muted {
  color: rgba(255, 255, 255, 0.8);
}

.status-price {
  color: #ffffff;
  font-size: 44rpx;
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 27rpx;
  font-weight: 500;
}

.item-meta {
  font-size: 22rpx;
  color: #9aa6a0;
  margin-top: 4rpx;
}

.item-amount {
  font-size: 26rpx;
  margin-left: 20rpx;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.amount-row.total {
  margin-top: 10rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.discount {
  color: #12a15a;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f6f4;
}

.info-row:last-child {
  border-bottom: none;
}

.info-value {
  font-size: 26rpx;
  color: #26332d;
  text-align: right;
  margin-left: 24rpx;
  max-width: 460rpx;
}

.eval-score {
  font-size: 28rpx;
  color: #e9832f;
  font-weight: 600;
}

.eval-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #4d5b55;
}

.score-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.score-star {
  font-size: 48rpx;
  color: #d9e2dd;
}

.score-star.active {
  color: #f3b23b;
}

.eval-input {
  width: 100%;
  height: 140rpx;
  margin-bottom: 20rpx;
}

.eval-btn {
  height: 72rpx;
  line-height: 72rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(18, 161, 90, 0.08);
}

.action-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
}

.pay-btn {
  flex: 1.4;
}
