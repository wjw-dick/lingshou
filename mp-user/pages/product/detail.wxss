.detail-page {
  padding-bottom: 180rpx;
}

.hero-card {
  height: 520rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  font-weight: 700;
  color: #b5d8c3;
  background: linear-gradient(135deg, #f2faf5, #dff3e8);
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.price.big {
  font-size: 52rpx;
}

.origin-price {
  font-size: 23rpx;
  color: #b3bcb8;
  text-decoration: line-through;
  flex: 1;
}

.product-name {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.product-spec {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8b9791;
}

.tag-row {
  margin-top: 16rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f6f4;
}

.info-row:last-child {
  border-bottom: none;
}

.info-value {
  font-size: 26rpx;
  color: #26332d;
  text-align: right;
  margin-left: 28rpx;
  max-width: 440rpx;
}

.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(18, 161, 90, 0.08);
}

.qty-box {
  display: flex;
  align-items: center;
  background: #f4f7f5;
  border-radius: 999rpx;
  padding: 4rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: #12a15a;
}

.qty-value {
  min-width: 44rpx;
  text-align: center;
  font-size: 26rpx;
}

.buy-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.total-price {
  font-size: 36rpx;
}

.cart-btn,
.buy-btn {
  height: 72rpx;
  line-height: 68rpx;
  padding: 0 24rpx;
  font-size: 25rpx;
  flex-shrink: 0;
}

.buy-btn {
  height: 72rpx;
  line-height: 72rpx;
  margin-left: 12rpx;
}
