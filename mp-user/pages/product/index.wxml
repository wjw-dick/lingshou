<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索商品名称" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" />
    <view class="search-btn" bindtap="search">搜索</view>
  </view>

  <scroll-view class="tabs" scroll-x="{{true}}">
    <view class="tab {{categoryId === '' ? 'active' : ''}}" data-id="" bindtap="selectCategory">全部</view>
    <view wx:for="{{categories}}" wx:key="id" class="tab {{categoryId == item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view>
  </scroll-view>

  <view class="toolbar">
    <text class="muted">共 {{products.length}} 件商品</text>
    <text class="cart-link" bindtap="goCart">购物车（{{cartCount}}）</text>
  </view>

  <view wx:if="{{loading}}" class="loading">正在加载商品...</view>
  <view wx:elif="{{error}}" class="error-box" bindtap="loadProducts">{{error}}，点击重试</view>
  <view wx:elif="{{!products.length}}" class="empty">没有找到相关商品</view>

  <view wx:else class="product-grid">
    <view class="product-card" wx:for="{{products}}" wx:key="skuId" data-skuid="{{item.skuId}}" bindtap="goDetail">
      <view class="product-thumb">
        <image wx:if="{{item.image}}" class="product-image" src="{{item.image}}" mode="aspectFill"></image>
        <view wx:else class="product-placeholder">{{item.initial}}</view>
      </view>
      <view class="product-body">
        <view class="product-name">{{item.name}}</view>
        <view class="product-spec">{{item.spec}} {{item.unit}}</view>
        <view wx:if="{{item.tags}}" class="product-tags">{{item.tags}}</view>
        <view class="product-bottom">
          <view>
            <view class="price"><text class="price-symbol">¥</text>{{item.price}}</view>
            <view class="origin">¥{{item.originPrice}}</view>
          </view>
          <view class="add-btn" catchtap="addCart" data-skuid="{{item.skuId}}">+</view>
        </view>
      </view>
    </view>
  </view>
</view>
