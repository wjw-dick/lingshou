<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索门店名称或地址" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" />
    <view class="search-btn" bindtap="search">搜索</view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在加载门店...</view>
  <view wx:elif="{{error}}" class="error-box" bindtap="loadStores">{{error}}，点击重试</view>
  <view wx:elif="{{!stores.length}}" class="empty">附近暂无营业门店</view>

  <view wx:else>
    <view class="store-card" wx:for="{{stores}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="store-avatar">{{item.initial}}</view>
      <view class="store-info">
        <view class="store-head">
          <view class="store-name ellipsis">{{item.name}}</view>
          <view class="status-pill green">{{item.openText}}</view>
        </view>
        <view class="store-meta">
          <text class="tag">{{item.regionText}}</text>
          <text class="store-delivery">{{item.deliveryText}}</text>
        </view>
        <view class="store-address">{{item.address}}</view>
        <view class="store-foot">
          <text class="muted">营业时间 {{item.businessHours || '09:00-22:00'}}</text>
          <text class="store-arrow">查看详情 ›</text>
        </view>
      </view>
    </view>
  </view>
</view>
