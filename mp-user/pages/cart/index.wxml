<view class="page cart-page">
  <view wx:if="{{!hasToken}}" class="card login-tip">
    <view class="login-tip-title">登录后提交订单</view>
    <view class="muted">登录可享会员价、积分抵扣与优惠券</view>
    <button class="btn-primary login-tip-btn" bindtap="goLogin">去登录</button>
  </view>

  <view wx:if="{{!cartItems.length}}" class="card empty-card">
    <view class="empty">购物车还是空的</view>
    <button class="btn-ghost" bindtap="goShopping">去逛逛</button>
  </view>

  <block wx:else>
    <view class="card">
      <view class="section-title">
        <text>购物车（{{cartItems.length}}）</text>
        <text class="muted">共 {{subtotalText}} 元</text>
      </view>
      <view class="cart-item" wx:for="{{cartItems}}" wx:key="skuId">
        <view class="item-thumb">
          <image wx:if="{{item.image}}" class="item-image" src="{{item.image}}" mode="aspectFill"></image>
          <view wx:else class="item-placeholder">{{item.initial}}</view>
        </view>
        <view class="item-body">
          <view class="item-name">{{item.name}}</view>
          <view class="item-spec">{{item.spec}}</view>
          <view class="item-bottom">
            <view class="price"><text class="price-symbol">¥</text>{{item.priceText}}</view>
            <view class="qty-box">
              <view class="qty-btn" bindtap="minusItem" data-skuid="{{item.skuId}}">-</view>
              <view class="qty-value">{{item.qty}}</view>
              <view class="qty-btn" bindtap="plusItem" data-skuid="{{item.skuId}}">+</view>
            </view>
          </view>
          <view class="item-remove" bindtap="removeItem" data-skuid="{{item.skuId}}">移除</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">
        <text>购物门店</text>
        <text class="link" bindtap="goStores">切换门店 ›</text>
      </view>
      <view wx:if="{{selectedStore}}" class="store-line">
        <view class="store-avatar">店</view>
        <view class="store-detail">
          <view class="store-name">{{selectedStore.name}}</view>
          <view class="muted">{{selectedStore.address}}</view>
        </view>
      </view>
      <view wx:else class="empty store-empty" bindtap="goStores">请选择购物门店</view>
    </view>

    <view class="card">
      <view class="section-title">收货方式</view>
      <view class="segment">
        <view class="segment-item {{deliveryType === 'PICKUP' ? 'active' : ''}}" data-type="PICKUP" bindtap="selectType">到店自提</view>
        <view class="segment-item {{deliveryType === 'DELIVERY' ? 'active' : ''}}" data-type="DELIVERY" bindtap="selectType">外送到家</view>
      </view>

      <block wx:if="{{deliveryType === 'DELIVERY'}}">
        <view wx:if="{{addresses.length}}" class="field">
          <text class="field-label">常用地址</text>
          <picker mode="selector" range="{{addressNames}}" bindchange="onAddressChange">
            <view class="picker-value">选择已保存地址 ›</view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">联系人</text>
          <input class="input field-input" placeholder="请输入姓名" value="{{deliveryName}}" data-field="deliveryName" bindinput="onFieldInput" />
        </view>
        <view class="field">
          <text class="field-label">手机号</text>
          <input class="input field-input" type="number" placeholder="请输入手机号" value="{{deliveryPhone}}" data-field="deliveryPhone" bindinput="onFieldInput" />
        </view>
        <view class="field">
          <text class="field-label">配送地址</text>
          <textarea class="input field-textarea" placeholder="请输入详细地址（可手填）" value="{{deliveryAddress}}" data-field="deliveryAddress" bindinput="onFieldInput"></textarea>
        </view>
        <view wx:if="{{deliveryRule}}" class="muted rule-tip">
          起送 ¥{{deliveryRule.minOrderAmount}}，配送费 ¥{{deliveryRule.deliveryFee}}，满 ¥{{deliveryRule.freeThreshold}} 免配送费
        </view>
      </block>
      <view wx:else class="muted pick-tip">下单后请前往 {{selectedStore.name || '所选门店'}} 自提</view>
    </view>

    <view class="card">
      <view class="field">
        <text class="field-label">优惠券</text>
        <picker mode="selector" range="{{couponNames}}" value="{{selectedCouponIndex}}" bindchange="onCouponChange">
          <view class="picker-value">{{selectedCouponName}} ›</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">积分抵扣</text>
        <input class="input field-input points-input" type="number" placeholder="可用 {{memberPoints}} 积分" value="{{pointsUsed}}" data-field="pointsUsed" bindinput="onFieldInput" bindblur="calcAmount" />
      </view>
      <view class="muted">100 积分抵 1 元，本单可用 {{memberPoints}} 积分</view>
      <view class="field">
        <text class="field-label">备注</text>
        <input class="input field-input" placeholder="选填，如少冰、放门口" value="{{remark}}" data-field="remark" bindinput="onFieldInput" />
      </view>
    </view>

    <view class="card summary">
      <view class="summary-row">
        <text class="label">商品金额</text>
        <text>¥{{subtotalText}}</text>
      </view>
      <view class="summary-row">
        <text class="label">优惠券优惠</text>
        <text class="discount">-¥{{discountText}}</text>
      </view>
      <view class="summary-row">
        <text class="label">积分抵扣</text>
        <text class="discount">-¥{{pointsDiscountText}}</text>
      </view>
      <view class="summary-row">
        <text class="label">配送费</text>
        <text>¥{{freightText}}</text>
      </view>
      <view class="divider"></view>
      <view class="summary-row total-row">
        <text>应付</text>
        <text class="price total-price"><text class="price-symbol">¥</text>{{payableText}}</text>
      </view>
    </view>

    <view class="submit-bar">
      <view class="submit-total">
        <text class="muted">应付</text>
        <text class="price total-price"><text class="price-symbol">¥</text>{{payableText}}</text>
      </view>
      <button class="btn-primary submit-btn" bindtap="submitOrder" disabled="{{submitting}}">{{submitting ? '提交中...' : '提交订单'}}</button>
    </view>
  </block>
</view>
