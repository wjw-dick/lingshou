.login-tip {
  text-align: center;
}

.login-title {
  font-size: 30rpx;
  font-weight: 600;
}

.login-btn {
  margin-top: 20rpx;
}

.segment {
  display: flex;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #6b7873;
  border-radius: 999rpx;
}

.segment-item.active {
  background: #12a15a;
  color: #ffffff;
  font-weight: 600;
}

.coupon-card {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 161, 90, 0.06);
}

.coupon-card.disabled {
  opacity: 0.55;
}

.coupon-left {
  width: 220rpx;
  background: linear-gradient(135deg, #12a15a, #37bd78);
  color: #ffffff;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.coupon-value {
  font-size: 44rpx;
  font-weight: 700;
}

.coupon-threshold {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.82);
  text-align: center;
}

.coupon-right {
  flex: 1;
  padding: 28rpx;
  min-width: 0;
}

.coupon-name {
  font-size: 29rpx;
  font-weight: 600;
}

.coupon-validity {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa6a0;
}

.coupon-status {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #12a15a;
}

.coupon-action {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
