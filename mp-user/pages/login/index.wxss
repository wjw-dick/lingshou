.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eaf7f0, #f4f7f5 55%);
  padding: 0 40rpx 60rpx;
  box-sizing: border-box;
}

.login-hero {
  padding: 120rpx 0 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 130rpx;
  height: 130rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #12a15a, #62cf98);
  color: #ffffff;
  font-size: 58rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(18, 161, 90, 0.28);
}

.brand {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #17352a;
}

.slogan {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #7c8b84;
}

.login-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(18, 161, 90, 0.1);
}

.login-title {
  font-size: 36rpx;
  font-weight: 700;
}

.login-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b9791;
}

.demo-info {
  margin: 30rpx 0;
  background: #f6faf8;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.demo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #4d5b55;
}

.login-btn {
  width: 100%;
}

.skip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8b9791;
}

.api-tip {
  margin-top: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: #aab5b0;
}
