.add-btn {
  margin-bottom: 20rpx;
}

.product-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 161, 90, 0.06);
}

.product-name {
  font-size: 29rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.product-meta {
  margin-top: 6rpx;
}

.product-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.edit-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #12a15a;
  text-align: right;
}

.form-line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f6f4;
}

.item-label {
  width: 200rpx;
  font-size: 25rpx;
  color: #6b7873;
  flex-shrink: 0;
}

.item-input {
  flex: 1;
  text-align: right;
  background: #f5f8f6;
  padding: 10rpx 18rpx;
}

.item-text {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
}

.form-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9aa6a0;
}
