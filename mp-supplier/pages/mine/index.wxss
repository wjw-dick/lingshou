.profile-card {
  background: linear-gradient(135deg, #0d8b4f, #12a15a 60%, #59c98c);
  border-radius: 28rpx;
  color: #ffffff;
  padding: 34rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(18, 161, 90, 0.22);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  margin-right: 24rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 33rpx;
  font-weight: 700;
}

.profile-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
}

.login-link {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f6f4;
  font-size: 26rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-value {
  text-align: right;
  margin-left: 20rpx;
  max-width: 440rpx;
}

.menu-card {
  padding: 4rpx 28rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f3f6f4;
  font-size: 27rpx;
}

.cell:last-child {
  border-bottom: none;
}

.cell-arrow {
  color: #c3ccc8;
  font-size: 32rpx;
}

.logout {
  justify-content: center;
  color: #c0432b;
}

.version {
  margin-top: 30rpx;
  text-align: center;
  font-size: 21rpx;
  color: #b3bcb8;
}
