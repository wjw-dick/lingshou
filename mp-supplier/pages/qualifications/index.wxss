.supplier-card {
  background: linear-gradient(135deg, #ffffff, #f0faf4);
}

.supplier-name {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.address {
  margin-top: 6rpx;
}

.add-btn {
  margin-bottom: 20rpx;
}

.qualification-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 161, 90, 0.06);
}

.qualification-type {
  font-size: 28rpx;
  font-weight: 600;
}

.expire {
  margin-top: 6rpx;
}

.file-url {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  background: #f6faf8;
  border-radius: 14rpx;
  font-size: 23rpx;
  color: #2f6bff;
}

.form-line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f6f4;
}

.item-label {
  width: 180rpx;
  font-size: 25rpx;
  color: #6b7873;
  flex-shrink: 0;
}

.item-input {
  flex: 1;
  text-align: right;
  background: #f5f8f6;
  padding: 10rpx 18rpx;
}

.picker-value {
  text-align: right;
  font-size: 25rpx;
  color: #12a15a;
}
