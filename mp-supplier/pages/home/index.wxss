.hero-card {
  background: linear-gradient(135deg, #0d8b4f, #12a15a 55%, #59c98c);
  border-radius: 28rpx;
  color: #ffffff;
  padding: 34rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(18, 161, 90, 0.22);
}

.hero-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  padding: 5rpx 18rpx;
  font-size: 21rpx;
}

.hero-name {
  margin-top: 16rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-stats {
  margin-top: 28rpx;
  display: flex;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 20rpx;
  padding: 18rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
}

.login-tip {
  text-align: center;
}

.login-title {
  font-size: 28rpx;
  font-weight: 600;
}

.login-btn {
  margin-top: 20rpx;
}

.quick-grid {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 161, 90, 0.06);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-icon.green {
  background: linear-gradient(135deg, #12a15a, #62cf98);
}

.quick-icon.blue {
  background: linear-gradient(135deg, #2f6bff, #7aa2ff);
}

.quick-icon.orange {
  background: linear-gradient(135deg, #f08a24, #ffc46b);
}

.quick-icon.pink {
  background: linear-gradient(135deg, #e05a8a, #ff9bbf);
}

.quick-text {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #4d5b55;
}

.link {
  font-size: 24rpx;
  color: #12a15a;
  font-weight: 400;
}

.small-empty {
  padding: 30rpx 0;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f6f4;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-no {
  font-size: 26rpx;
  font-weight: 600;
}

.recent-right {
  text-align: right;
  margin-left: 20rpx;
}

.recent-amount {
  margin-top: 6rpx;
  font-size: 26rpx;
}
