<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'PENDING' ? 'active' : ''}}" data-value="PENDING" bindtap="switchTab">待收货</view>
    <view class="tab {{tab === 'CONFIRMED' ? 'active' : ''}}" data-value="CONFIRMED" bindtap="switchTab">已收货</view>
  </view>

  <view wx:if="{{loading && !orders.length}}" class="loading">正在加载收货单...</view>
  <view wx:elif="{{error}}" class="error-box" bindtap="loadOrders">{{error}}，点击重试</view>
  <view wx:elif="{{!orders.length}}" class="empty">暂无收货单</view>

  <block wx:else>
    <view class="receive-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="between">
        <view class="receive-no">{{item.receiveNo}}</view>
        <view class="status-pill {{item.status === 'CONFIRMED' ? 'gray' : 'orange'}}">{{item.statusText}}</view>
      </view>
      <view class="receive-meta">供货单 #{{item.supplyId}} · {{item.createdText}}</view>
      <view class="receive-foot">
        <text class="muted">应收 {{item.totalQty || 0}} 件</text>
        <text wx:if="{{item.diffQty}}" class="diff-text">差异 {{item.diffQty}} 件</text>
        <text class="detail-link">查看/收货 ›</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="loading">加载更多中...</view>
    <view wx:elif="{{orders.length >= total}}" class="muted list-end">没有更多收货单了</view>
  </block>

  <view wx:if="{{showDetail}}" class="modal-mask" bindtap="closeDetail">
    <view class="modal-panel" catchtap="stopTap">
      <view class="modal-title">收货确认</view>
      <view wx:if="{{detailLoading}}" class="loading">正在加载明细...</view>
      <block wx:elif="{{detail}}">
        <view class="between">
          <view class="detail-no">{{detail.receiveNo}}</view>
          <view class="status-pill {{detail.status === 'CONFIRMED' ? 'gray' : 'orange'}}">{{detail.statusText}}</view>
        </view>
        <view class="muted detail-meta">{{detail.createdText}}</view>

        <view class="item-block" wx:for="{{editItems}}" wx:key="id">
          <view class="item-head">
            <view class="item-name">{{item.skuName}}</view>
            <view class="muted">应收 {{item.qty}}</view>
          </view>
          <view class="item-line">
            <text class="item-label">实收数量</text>
            <input class="input item-input" type="number" value="{{item.actualQty}}" data-index="{{index}}" data-field="actualQty" bindinput="onItemInput" />
          </view>
          <view class="item-line">
            <text class="item-label">生产日期</text>
            <picker mode="date" value="{{item.productionDate}}" data-index="{{index}}" data-field="productionDate" bindchange="onDateChange">
              <view class="picker-value">{{item.productionDate || '请选择'}} ›</view>
            </picker>
          </view>
          <view class="item-line">
            <text class="item-label">到期日期</text>
            <picker mode="date" value="{{item.expiryDate}}" data-index="{{index}}" data-field="expiryDate" bindchange="onDateChange">
              <view class="picker-value">{{item.expiryDate || '请选择'}} ›</view>
            </picker>
          </view>
          <view class="item-line">
            <text class="item-label">批次号</text>
            <input class="input item-input" placeholder="请输入批次号" value="{{item.batchNo}}" data-index="{{index}}" data-field="batchNo" bindinput="onItemInput" />
          </view>
          <view class="item-line">
            <text class="item-label">冷链温度</text>
            <input class="input item-input" type="digit" placeholder="冷藏/冷冻必填 ℃" value="{{item.coldChainTemp}}" data-index="{{index}}" data-field="coldChainTemp" bindinput="onItemInput" />
          </view>
        </view>

        <view class="form-block">
          <view class="item-line">
            <text class="item-label">收货人</text>
            <input class="input item-input" value="{{form.receiver}}" data-field="receiver" bindinput="onFormInput" />
          </view>
          <view class="item-line">
            <text class="item-label">整体冷链温度</text>
            <input class="input item-input" type="digit" placeholder="选填 ℃" value="{{form.coldChainTemp}}" data-field="coldChainTemp" bindinput="onFormInput" />
          </view>
          <view class="item-line">
            <text class="item-label">备注</text>
            <input class="input item-input" placeholder="选填" value="{{form.remark}}" data-field="remark" bindinput="onFormInput" />
          </view>
        </view>

        <view class="modal-actions">
          <button class="btn-ghost" bindtap="closeDetail">取消</button>
          <button class="btn-primary" bindtap="confirmReceive" disabled="{{submitting || detail.status === 'CONFIRMED'}}">确认收货</button>
        </view>
      </block>
    </view>
  </view>
</view>
