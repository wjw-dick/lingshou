.create-page {
  padding-bottom: 180rpx;
}

.login-tip {
  text-align: center;
}

.login-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.login-btn {
  margin-top: 20rpx;
}

.store-card {
  background: linear-gradient(135deg, #ffffff, #f4fcf7);
}

.picker-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.picker-value {
  font-size: 30rpx;
  font-weight: 600;
}

.picker-arrow {
  font-size: 24rpx;
  color: #12a15a;
}

.form-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-top: 1rpx solid #f3f6f4;
  margin-top: 10rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 10rpx 12rpx 10rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 161, 90, 0.06);
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  height: 60rpx;
}

.search-btn {
  background: #12a15a;
  color: #ffffff;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
  font-size: 24rpx;
}

.product-card {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 161, 90, 0.06);
}

.product-thumb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #f2f7f4;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-weight: 700;
  color: #b5d8c3;
}

.product-body {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
}

.product-spec {
  margin-top: 4rpx;
}

.product-bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.unit-text {
  font-size: 20rpx;
  font-weight: 400;
}

.qty-box {
  display: flex;
  align-items: center;
  background: #f4f7f5;
  border-radius: 999rpx;
  padding: 4rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 30rpx;
  color: #12a15a;
}

.qty-btn.disabled {
  color: #c3ccc8;
}

.qty-btn.plus {
  color: #ffffff;
  background: #12a15a;
  border-radius: 50%;
}

.qty-value {
  min-width: 44rpx;
  text-align: center;
  font-size: 25rpx;
}

.remark-input {
  flex: 1;
  margin-left: 20rpx;
  text-align: right;
  background: #f8fbf9;
  padding: 10rpx 18rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(18, 161, 90, 0.08);
  z-index: 20;
}

.submit-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.total-price {
  font-size: 38rpx;
}

.submit-btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 48rpx;
}
