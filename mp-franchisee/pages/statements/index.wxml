<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载对账单...</view>
  <view wx:elif="{{error}}" class="error-box" bindtap="loadData">{{error}}，点击重试</view>
  <view wx:elif="{{!list.length}}" class="empty">暂无对账单</view>

  <view wx:else>
    <view class="statement-card" wx:for="{{list}}" wx:key="id">
      <view class="between">
        <view class="statement-no">{{item.statementNo}}</view>
        <view class="status-pill {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="muted period">{{item.periodText}}</view>

      <view class="amount-grid">
        <view class="amount-item">
          <view class="amount-value">¥{{item.totalText}}</view>
          <view class="amount-label">对账金额</view>
        </view>
        <view class="amount-item">
          <view class="amount-value">¥{{item.deductionText}}</view>
          <view class="amount-label">扣款</view>
        </view>
        <view class="amount-item">
          <view class="amount-value highlight">¥{{item.payableText}}</view>
          <view class="amount-label">应付金额</view>
        </view>
      </view>

      <view class="statement-foot">
        <text class="muted">{{item.createdText}}</text>
        <button wx:if="{{item.status === 'PENDING'}}" class="btn-primary btn-sm" data-index="{{index}}" bindtap="confirmStatement" disabled="{{acting}}">确认对账</button>
        <text wx:else class="muted">{{item.confirmedAt ? '已确认' : '—'}}</text>
      </view>
    </view>
  </view>
</view>
