.store-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 161, 90, 0.06);
}

.store-head {
  display: flex;
  align-items: center;
}

.store-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eaf7f0, #d4f0e0);
  color: #12a15a;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.store-name {
  font-size: 30rpx;
  font-weight: 600;
}

.store-address {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #f8fbf9;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #6b7873;
}

.metric-grid {
  display: flex;
  margin-top: 18rpx;
}

.metric-item {
  flex: 1;
  text-align: center;
}

.metric-item + .metric-item {
  border-left: 1rpx solid #f0f4f2;
}

.metric-value {
  font-size: 30rpx;
  font-weight: 700;
}

.metric-label {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #9aa6a0;
}

.store-foot {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f6f4;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
