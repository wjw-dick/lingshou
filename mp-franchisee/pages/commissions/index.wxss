.summary-card {
  background: linear-gradient(135deg, #0d8b4f, #12a15a 55%, #59c98c);
  border-radius: 28rpx;
  color: #ffffff;
  padding: 34rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(18, 161, 90, 0.22);
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.summary-value {
  margin-top: 8rpx;
  font-size: 58rpx;
  font-weight: 700;
}

.summary-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.72);
}

.commission-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 161, 90, 0.06);
}

.period {
  font-size: 28rpx;
  font-weight: 600;
}

.store-line {
  margin-top: 6rpx;
}

.amount-row {
  display: flex;
  margin-top: 16rpx;
  background: #f8fbf9;
  border-radius: 18rpx;
  padding: 16rpx 0;
}

.amount-item {
  flex: 1;
  text-align: center;
}

.amount-value {
  font-size: 26rpx;
  font-weight: 600;
}

.amount-value.highlight {
  color: #e8542f;
}

.amount-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #9aa6a0;
}

.created {
  margin-top: 12rpx;
  text-align: right;
}
